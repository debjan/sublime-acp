    // Ignore patterns for autocompletion (besides .gitignore)
    "ignore": {
        "folders": [".git", ".svn", ".hg", ".venv", "node_modules"],
        "extensions": [".pyc", ".pyo", ".pyd", ".so", ".dll", ".exe", ".o", ".a", ".lib", ".class"],
    },
    // Re-include paths for autocompletion, overriding .gitignore and "ignore"
    "allow": {
        // Exact directory names; the whole subtree is included
        "folders": [],
        // File extensions, with or without a leading dot
        "extensions": [],
        // Gitignore-style globs; a trailing "/" matches directories only
        "patterns": [],
    },
    // Custom quick actions shown in the prompt panel
    "actions": [
        {
            "title": "Explain",
            "prompt": "Explain in simple terms"
        },
        {
            "title": "Summarize",
            "prompt": "Summarize with key points"
        },
    ],
    // Automatically attach the current selection as context (@path:line-line or a code block)
    "attach_selection": false,

    // Append markdown dividers (---) after each user prompt and agent reply
    "turn_dividers": true,

    // Append an HTML comment at the end of each agent turn with the end time
    // and duration, e.g. <!-- [14:32:07] Duration: 00:01:23 -->
    "turn_signature": true,

    // Font size (points) applied to ACP scratch output views (null = global font size)
    "font_size": null,

    // Show context token usage in the status bar (e.g. ctx 27% (53k/200k))
    "context_usage": true,

    // Git-based "Changed files" summary after each agent turn
    // (silent no-op outside git repos):
    //   "diff"       - filenames + per-file diff fences
    //   "counts"     - filenames with change counts only (default)
    //   false        - disabled entirely
    "git_turn_summary": "counts",

    // How agent thought chunks (thinking...) are surfaced:
    //   "enabled"  - thoughts render in the output view as blockquotes (default)
    //   "disabled" - thoughts are dropped; view shows the reply only
    "thoughts": "disabled",

    // How agent tool call results are surfaced in the output view:
    //   "enabled"  - each completed/failed tool call renders as a one-line markdown task item (default)
    //   "disabled" - tool call results are not rendered
    "tool_calls": "enabled",

    // Maximum sessions shown by "ACP: Switch Session" (session/list)
    "session_list_limit": 10,

    // Replay full conversation history into the output view when switching
    // sessions (via session/load). false = only show a "switched" notice.
    "session_replay_on_switch": false,

    // Seconds of inactivity before auto-terminating the daemon (0 = disabled)
    "daemon_idle_timeout": 900,

    // Idle timeout in seconds: how long to wait for the agent to produce any
    // output (streamed text, thought chunks, tool calls, file edits) before the
    // turn is timed out and cancelled. The clock resets on any agent activity,
    // so long-running multi-edit turns won't time out while the agent is working.
    "timeout": 600,

    // Show a desktop toast when an agent turn ends. Windows: native toast
    // with the "Default" sound plus a taskbar flash; macOS: Notification
    // Center banner with the "default" alert; Linux: notify-send
    "turn_end_flash": true,

    // Same for permission prompts and elicitation questions
    "prompt_flash": true,

    // Hard cap in seconds for an open permission prompt: after this the prompt
    // is denied and the turn continues (0 = wait forever). Prompts are queued
    // per window, so back-to-back requests each get their own panel.
    "permission_prompt_timeout": 300,

    // Seconds before @-file completions and agent-info caches expire (0 = always refresh)
    "cache_ttl": 300,

    // Permission control for agent tool calls (session/request_permission) and host-fs operations
    // auto_allow: glob patterns for tool call kinds to auto-approve (e.g., "read*")
    // auto_reject: glob patterns for tool call kinds to auto-reject (takes priority over auto_allow)
    // sensitive_globs: fnmatch globs (basename or full path) for secret-bearing files;
    //   matching fs reads always prompt (daemon) or deny (one-shot), even under auto_allow
    // fs/read_text_file maps to kind "read_file"; fs/write_text_file maps to kind "write_file"
    // Default: reads (incl. host-fs reads) are auto-allowed; writes (incl. host-fs writes)
    // prompt in daemon mode and are denied in one-shot mode unless matched by auto_allow
    "permissions": {
        "auto_allow": ["read*"],
        "auto_reject": [],
        "sensitive_globs": [".env", "*.pem", "*key*", "secrets.*"]
    },

    // Enable debug logging to the dedicated ACP Log output panel.
    "debug": false,
}
